---
layout: base
title: Speakers
currentTab: speakers
permalink: /speakers/index.html
---

<div class="hero-block" style="background-color: #fff; color: #424242;">
  <div class="container hero-content">
    <div class="hero-title highlight-font">{{ settings.heroSettings.speakers.title }}</div>
    <p class="hero-description">{{ settings.heroSettings.speakers.description }}</p>
  </div>
</div>

<!-- Filter Menu (matches original filter-menu.html) -->
<div class="filter-menu" data-filter-target="speakers">
  <div class="filters-toolbar container">
    <div class="filters-toolbar-row">
      <div class="filters-results" hidden></div>
      <div class="filters-actions">
        <button type="button" class="reset-filters" hidden>{{ resources.filters.clear }}</button>
        <button type="button" class="paper-button icon-right filters-toggle-btn">
          <span>{{ resources.filters.title }}</span>
          <svg width="20" height="20" fill="currentColor"><use href="#icon-filter-list"/></svg>
        </button>
      </div>
    </div>
    <div class="selected-filters" hidden></div>
  </div>
  <div class="filters-board">
    <div class="container">
      <div class="filter-group">
        <h3 class="filter-title">{{ resources.filters.tags }}</h3>
        {% for tag in conference.filters.tags %}
        <button type="button" class="tag" style="--color: {{ tag | tagColor }};" data-filter-key="tag" data-filter-value="{{ tag | slugClass }}">
          {{ tag }}
        </button>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="container">
  <div class="speakers-page-grid">
    {% for speaker in conference.speakersList %}
    <div class="speaker-card-full card" id="card-{{ speaker.id }}" data-tags="{% for tag in speaker.tags %}{{ tag | slugClass }}{% if not loop.last %},{% endif %}{% endfor %}">
      <a href="#{{ speaker.id }}" class="card-overlay-link" aria-label="{{ speaker.name }}"></a>

      <div class="photo-wrap">
        <img class="photo" src="{{ speaker.photoUrl | url }}" alt="{{ speaker.name }}" loading="lazy">
        {% if speaker.badges and speaker.badges.length %}
        <div class="speaker-badges">
          {% for badge in speaker.badges %}
          <a class="badge {{ badge.name }}-b" href="{{ badge.link }}" target="_blank" rel="noopener noreferrer" title="{{ badge.description }}">
            <svg class="badge-icon"><use href="#icon-{{ badge.name }}"/></svg>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      {% if speaker.companyLogoUrl %}
      <img class="company-logo" src="{{ speaker.companyLogoUrl | url }}" alt="{{ speaker.company }}" loading="lazy">
      {% endif %}

      <div class="description">
        <h2 class="name">{{ speaker.name }}</h2>
        {% if speaker.country %}
        <div class="origin">{{ speaker.country }}</div>
        {% endif %}
        {% if speaker.bio %}
        <div class="bio">{{ speaker.bio }}</div>
        {% endif %}
      </div>

      {% if speaker.socials and speaker.socials.length %}
      <div class="contacts">
        {% for social in speaker.socials %}
          {% if social.link %}
          <a href="{{ social.link }}" target="_blank" rel="noopener noreferrer" class="social-icon" title="{{ social.name or social.icon }}" aria-label="{{ social.name or social.icon }}">
            {% if social.icon == 'twitter' %}
            <svg><use href="#icon-twitter"/></svg>
            {% elseif social.icon == 'github' %}
            <svg><use href="#icon-github"/></svg>
            {% elseif social.icon == 'linkedin' %}
            <svg><use href="#icon-linkedin"/></svg>
            {% elseif social.icon == 'instagram' %}
            <svg><use href="#icon-instagram"/></svg>
            {% elseif social.icon == 'medium' %}
            <svg><use href="#icon-medium"/></svg>
            {% elseif social.icon == 'website' %}
            <svg><use href="#icon-website"/></svg>
            {% elseif social.icon == 'meetup' %}
            <svg><use href="#icon-meetup"/></svg>
            {% elseif social.icon == 'youtube' %}
            <svg><use href="#icon-youtube"/></svg>
            {% else %}
            <svg><use href="#icon-website"/></svg>
            {% endif %}
          </a>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>

<!-- Pure No-JS Modals (matches dialog-styles.html & speaker-details.html) -->
{% for speaker in conference.speakersList %}
<div id="{{ speaker.id }}" class="modal-overlay">
  <a href="#card-{{ speaker.id }}" class="modal-backdrop-close" aria-label="Close"></a>
  <div class="modal-dialog-wrap">
    <a href="#card-{{ speaker.id }}" class="dialog-close-btn" aria-label="Close">
      <svg class="icon-desktop-close"><use href="#icon-close"/></svg>
      <svg class="icon-mobile-back"><use href="#icon-arrow-left"/></svg>
    </a>
    <div class="modal-dialog">
      <div class="dialog-header">
        <div class="dialog-container dialog-header-content header-horizontal">
          <img src="{{ speaker.photoUrl | url }}" alt="{{ speaker.name }}" style="width: 96px; height: 96px; border-radius: 50%; object-fit: cover; background: var(--contrast-additional-background-color); flex-shrink: 0;">
          <div>
            <h2 class="name highlight-font">{{ speaker.name }}</h2>
            {% if speaker.headerSubtitle %}
            <div style="font-size: 16px; color: var(--secondary-text-color); margin-top: 4px;">
              {{ speaker.headerSubtitle }}
            </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="dialog-body">
        <div class="dialog-content dialog-container">
          {% if speaker.companyInfo %}
          <h3 class="meta-info">{{ speaker.companyInfo }}</h3>
          {% endif %}

          {% if speaker.badges and speaker.badges.length %}
          <h3 class="meta-info" style="margin-top: 4px;">
            {% for badge in speaker.badges %}
            <a href="{{ badge.link }}" target="_blank" rel="noopener noreferrer" title="{{ badge.description }}">{{ badge.description }}</a>{% if not loop.last %}, {% endif %}
            {% endfor %}
          </h3>
          {% endif %}

          {% if speaker.bio %}
          <div class="description">{{ speaker.bio | markdown | safe }}</div>
          {% endif %}

          {% if speaker.socials and speaker.socials.length %}
          <div style="display: flex; gap: 16px; margin-top: 16px;">
            {% for s in speaker.socials %}
              {% if s.link %}
              <a href="{{ s.link }}" target="_blank" rel="noopener noreferrer" style="color: var(--secondary-text-color);" title="{{ s.name or s.icon }}" aria-label="{{ s.name or s.icon }}">
                {% if s.icon == 'twitter' %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-twitter"/></svg>
                {% elseif s.icon == 'github' %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-github"/></svg>
                {% elseif s.icon == 'linkedin' %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-linkedin"/></svg>
                {% elseif s.icon == 'instagram' %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-instagram"/></svg>
                {% elseif s.icon == 'medium' %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-medium"/></svg>
                {% elseif s.icon == 'website' %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-website"/></svg>
                {% elseif s.icon == 'meetup' %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-meetup"/></svg>
                {% elseif s.icon == 'youtube' %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-youtube"/></svg>
                {% else %}
                <svg width="20" height="20" fill="currentColor"><use href="#icon-website"/></svg>
                {% endif %}
              </a>
              {% endif %}
            {% endfor %}
          </div>
          {% endif %}

          {% if speaker.sessions and speaker.sessions.length %}
          <div style="margin-top: 32px;">
            <h3 class="highlight-font" style="font-size: 1.17em; font-weight: normal;">{{ resources.speakerDetails.sessions }}</h3>
            {% for sess in speaker.sessions %}
            <a href="{{ ('/schedule/#' + sess.id) | url }}" style="display: block; margin-top: 16px; color: var(--primary-text-color);">
              <div style="margin-bottom: 4px; line-height: 1.2; font-size: 15px;">{{ sess.title }}</div>
              <div style="font-size: 12px; line-height: 1.4; color: var(--secondary-text-color);">
                {{ sess.dateReadable }}, {{ sess.startTime }} - {{ sess.endTime }}
              </div>
              <div style="font-size: 12px; line-height: 1.4; color: var(--secondary-text-color);">
                {{ sess.track.title }}
              </div>
              {% if sess.tags and sess.tags.length %}
              <div style="margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px;">
                {% for tag in sess.tags %}
                <span class="tag" style="color: {{ tag | tagColor }}; border-color: {{ tag | tagColor }};">{{ tag }}</span>
                {% endfor %}
              </div>
              {% endif %}
            </a>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endfor %}

<!-- Previous Speakers Block (matches original previous-speakers-block.html) -->
<section class="previous-speakers-block">
  <div class="container">
    <h1 class="container-title highlight-font">{{ resources.previousSpeakersBlock.title }}</h1>

    <div class="previous-speakers-avatars">
      {% for prev in conference.previousSpeakers %}
      <a class="prev-speaker-avatar" href="{{ ('/previous-speakers/#' + prev.id) | url }}" title="{{ prev.name }}">
        <img class="photo" src="{{ prev.photoUrl | url }}" alt="{{ prev.name }}" loading="lazy">
      </a>
      {% endfor %}
    </div>

    <a href="{{ resources.previousSpeakersBlock.callToAction.link | url }}">
      <button class="paper-button animated icon-right">
        <span>{{ resources.previousSpeakersBlock.callToAction.label }}</span>
        <svg style="width: 20px; height: 20px; fill: currentColor;"><use href="#icon-arrow-right-circle"/></svg>
      </button>
    </a>
  </div>
</section>
