---
layout: base
title: Team
currentTab: team
permalink: /team/index.html
---

<div class="hero-block" style="background-color: #fff; color: #424242;">
  <div class="container hero-content" style="text-align: left;">
    <div class="hero-title highlight-font">{{ settings.heroSettings.team.title }}</div>
    <p class="hero-description">{{ settings.heroSettings.team.metaDescription }}</p>
  </div>
</div>

<div class="description-wrapper">
  <div class="container">
    <div class="description">{{ resources.team.description }}</div>
  </div>
</div>

<div class="container" style="padding-top: 32px; padding-bottom: 64px;">
  {% for team in conference.team %}
    <div class="team-title highlight-font">{{ team.title }}</div>

    <div class="team-block">
      {% for member in team.members %}
        <div class="member">
          <img class="photo" src="{{ member.photoUrl | url }}" alt="{{ member.name }}" loading="lazy">

          <div class="member-details">
            <h2 class="name highlight-font">{{ member.name }}</h2>
            {% if member.title %}
            <div class="activity">{{ member.title }}</div>
            {% endif %}
            {% if member.socials and member.socials.length %}
            <div class="contacts">
              {% for social in member.socials %}
                {% if social.link %}
                <a href="{{ social.link }}" target="_blank" rel="noopener noreferrer" class="social-icon" title="{{ social.name or social.icon }}" aria-label="{{ social.name or social.icon }}">
                  {% if social.icon == 'twitter' %}
                  <svg><use href="#icon-twitter"/></svg>
                  {% elseif social.icon == 'github' %}
                  <svg><use href="#icon-github"/></svg>
                  {% elseif social.icon == 'linkedin' %}
                  <svg><use href="#icon-linkedin"/></svg>
                  {% elseif social.icon == 'instagram' %}
                  <svg><use href="#icon-instagram"/></svg>
                  {% elseif social.icon == 'medium' %}
                  <svg><use href="#icon-medium"/></svg>
                  {% elseif social.icon == 'website' %}
                  <svg><use href="#icon-website"/></svg>
                  {% elseif social.icon == 'meetup' %}
                  <svg><use href="#icon-meetup"/></svg>
                  {% elseif social.icon == 'youtube' %}
                  <svg><use href="#icon-youtube"/></svg>
                  {% else %}
                  <svg><use href="#icon-arrow-right"/></svg>
                  {% endif %}
                </a>
                {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endfor %}
</div>
